{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  // D1 database for health check history
  // 作成方法: npx wrangler d1 create health-monitor
  // または Cloudflareダッシュボード > Workers & Pages > D1 > Create
  // 出力された database_id を下記に貼り付け。Workers Buildsの場合はダッシュボードで Bindings > D1 を追加でもOK
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-monitor",
      "database_id": "REPLACE_WITH_D1_ID",
      "preview_database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  // 5分ごとに死活監視を実行
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {},
  "observability": {
    "enabled": true
  }
}
