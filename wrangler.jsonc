{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  // KV namespace for storing health check history
  // 作成方法: wrangler kv namespace create HEALTH_KV  または Cloudflareダッシュボード > Workers & Pages > KV
  // 作成後に id を差し替える。Workers Buildsでデプロイする場合はダッシュボードで Bindings を設定することでもOK
  "kv_namespaces": [
    {
      "binding": "HEALTH_KV",
      "id": "REPLACE_WITH_KV_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_ID"
    }
  ],
  // 5分ごとに死活監視を実行
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    // フォールバック用: 環境変数で上書き可能だが、基本は src/config.ts で監視対象を管理
  },
  "observability": {
    "enabled": true
  }
}
